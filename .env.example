# ============================================================
# Marinasan Purchase System - Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git!
# Generate secrets: openssl rand -hex 32
# ============================================================

# --- App ---
FLASK_ENV=production
LOG_LEVEL=INFO
TZ=Asia/Tehran

# --- Security (REQUIRED) ---
# openssl rand -hex 32
MARINASAN_JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
POSTGRES_DB=marinasan
POSTGRES_USER=marinasan
POSTGRES_PASSWORD=change-this-to-a-strong-password

# --- Email - SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=سیستم درخواست خرید ماریناسان

# --- Email - EWS / Exchange (optional) ---
EMAIL_BACKEND=ews
EMAIL_ENABLED=false
EWS_ENABLED=false
EWS_URL=
EWS_USERNAME=
EWS_PASSWORD=
EWS_PRIMARY_SMTP=
EWS_DOMAIN=

# --- Frontend ---
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost

# --- Redis ---
REDIS_URL=redis://redis:6379/0
