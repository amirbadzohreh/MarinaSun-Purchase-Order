# =============================================================================
# MARINASAN PURCHASE SYSTEM - INTERNAL NETWORK DEPLOYMENT
# =============================================================================
# Copy this file to .env and fill in ALL values
# NEVER commit .env to version control!
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=false
LOG_LEVEL=INFO
TZ=Asia/Tehran

# -----------------------------------------------------------------------------
# SECURITY - GENERATE NEW SECRETS FOR PRODUCTION!
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
MARINASAN_JWT_SECRET=REPLACE_WITH_SECURE_32_BYTE_HEX
SECRET_KEY=REPLACE_WITH_ANOTHER_SECURE_32_BYTE_HEX

JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=12

# -----------------------------------------------------------------------------
# DATABASE - POSTGRESQL
# -----------------------------------------------------------------------------
# Internal Docker network (docker-compose.yml):
DATABASE_URL=postgresql://marinasan:SECURE_PASSWORD@postgres:5432/marinasan

# External managed DB (RDS, Cloud SQL, etc.):
# DATABASE_URL=postgresql://user:pass@your-db-host:5432/marinasan?sslmode=require

DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# -----------------------------------------------------------------------------
# REDIS - CACHING & SESSIONS
# -----------------------------------------------------------------------------
# Internal Docker network (docker-compose.yml):
REDIS_URL=redis://redis:6379/0

# External managed Redis (ElastiCache, etc.):
# REDIS_URL=redis://:password@your-redis-host:6379/0

REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# -----------------------------------------------------------------------------
# CORS & HOSTS - Internal network
# -----------------------------------------------------------------------------
# Replace with your internal server IP or hostname
# Example: http://192.168.1.100,http://marinasan.local
CORS_ORIGINS=http://YOUR_SERVER_IP,http://YOUR_SERVER_HOSTNAME

# Not needed for internal HTTP deployment
ALLOWED_HOSTS=*

# -----------------------------------------------------------------------------
# EMAIL (OPTIONAL - FOR NOTIFICATIONS)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=secure_smtp_password
SMTP_TLS=true
EMAIL_FROM=ماریناسان <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# FILE STORAGE (OPTIONAL - FOR ATTACHMENTS)
# -----------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_PATH=/app/uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY (OPTIONAL)
# -----------------------------------------------------------------------------
SENTRY_DSN=
ENABLE_METRICS=true
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_LOGIN=10 per minute
RATE_LIMIT_API=100 per minute

# -----------------------------------------------------------------------------
# BACKUP (OPTIONAL)
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=marinasan-backups
BACKUP_S3_PREFIX=database/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# DO NOT EDIT BELOW - AUTO-GENERATED
# =============================================================================